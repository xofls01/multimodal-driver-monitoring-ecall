[Unit]
Description=e-Call MSD service (research test, never calls 119)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 -u __DIR__/ecall_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
